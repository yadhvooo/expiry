# Server Port
PORT=5000
NODE_ENV=development

# JWT Secret for authentication
JWT_SECRET=rescuebites-super-secret-key-2026

# DATABASE CONFIGURATION
# -------------------------------------------------------------
# Option 1: MySQL (Connected with MySQL Workbench)
# Uncomment the lines below to use MySQL:
# DB_TYPE=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password_here
# MYSQL_DATABASE=rescuebites

# Option 2: PostgreSQL (Used on Render)
# DATABASE_URL=postgres://user:password@host:port/database

# Option 3: SQLite (Default if neither MySQL nor PostgreSQL is set)
# (Uses backend/data/marketplace.db automatically)
